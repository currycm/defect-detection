# ---------- 数据（体积大，不入库；用 scripts/prepare_data.py 重新生成）----------
data/raw/
data/processed/
data/samples/*.jpg
# 运行时生成的 data.yaml 副本（path 已绝对化，见 utils.paths.runtime_data_yaml）
configs/data.local.yaml

# ---------- 权重与训练产物 ----------
weights/*.pt
weights/*.onnx
weights/*.engine
weights/*.xml
# 根目录的预训练初始权重（6.2MB；scripts/train.py 的 --weights 默认值）
